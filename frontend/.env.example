# Base URL of the Policy Impact Engine backend API.
#
# Leave EMPTY for local development: `vite.config.ts` proxies `/api` to
# http://localhost:8080, which keeps requests same-origin. The backend denies
# cross-origin browser calls by default, so an empty value is the safest
# development default.
#
# Set an absolute origin (no trailing slash, no /api suffix) for deployments.
VITE_API_BASE_URL=
