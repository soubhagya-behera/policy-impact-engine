# ===================================================================
# EXAMPLE environment - GitHub-SAFE TEMPLATE (Phase 13-E)
# Copy to .env (same directory) and fill in REAL values. .env is
# Git-ignored and must never be committed. This file contains no
# real credentials, secrets, or JWT secrets.
#
#   cp .env.example .env
# ===================================================================

# --- PostgreSQL (Compose service: db) ---
# Database user for the policypulse database (also the backend login).
POSTGRES_USER=policyengine
# Database password: use a long random value, e.g. from a password manager.
POSTGRES_PASSWORD=change-me-to-a-long-random-database-password

# --- Backend ---
# JWT HS256 secret: at least 32 UTF-8 bytes (256 bits). Blank, missing,
# or short secrets fail fast at startup. Generate fresh per deployment.
SECURITY_JWT_SECRET=change-me-to-a-256-bit-secret-that-is-never-committed

# --- Optional local-AI profile (Compose profile: ai, OFF by default) ---
# Only useful when starting with: docker compose --profile ai up -d
# With the defaults below the backend runs exactly as without AI
# (explanations resolve to deterministic fallback). To enable, set:
# AI_ENABLED=true
# AI_BASE_URL=http://ollama:11434
# The model must already be available to the Ollama service
# (docker compose --profile ai exec ollama ollama pull llama3.1).
AI_MODEL=llama3.1
